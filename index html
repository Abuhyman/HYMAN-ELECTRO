<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HYMAN-ELECTRO — Load Assessment</title>
<style>
:root{
  --bg:#eef1f5;--card:#fff;--ink:#0f1b2d;--mut:#56657a;--line:#d5dce6;
  --r:#d6342c;--y:#e8a900;--b:#1f5fbf;--ok:#177a4b;--warn:#9a5b00;
