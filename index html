  }
}
:root[data-theme="dark"]{
  color-scheme:dark;--bg:#0b1320;--card:#121d2f;--ink:#e7edf6;--mut:#97a6bc;
  --line:#24344d;--r:#ff6b60;--y:#ffc83d;--b:#6aa3ff;--ok:#4fd08e;--warn:#ffc83d;
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font:16px/1.5 "Segoe UI",system-ui,-apple-system,Roboto,Arial,sans-serif;
}
.wrap{max-width:900px;margin:0 auto;padding:20px 16px 48px}
header{display:flex;align-items:center;gap:14px;margin-bottom:6px}
.tri{display:flex;flex-direction:column;gap:4px;width:34px}
.tri i{height:8px;border-radius:2px}
.tri i:nth-child(1){background:var(--r)}
.tri i:nth-child(2){background:var(--y)}
.tri i:nth-child(3){background:var(--b)}
h1{font-size:1.9rem;letter-spacing:-.03em;margin:0;font-weight:800;line-height:1}
.sub{color:var(--mut);margin:0 0 20px}
h2{font-size:1.1rem;margin:0 0 10px;font-weight:700}
section{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;margin-bottom:16px}
.g{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(190px,1fr))}
label{display:block;font-size:.85rem;color:var(--mut);margin-bottom:3px}
input,select,button{
  font:inherit;color:var(--ink);background:var(--bg);
  border:1px solid var(--line);border-radius:6px;padding:8px 10px;
  width:100%;min-height:40px;
}
button{width:auto;cursor:pointer;font-weight:600}
button.p{background:var(--b);border-color:var(--b);color:#fff}
:root:not([data-theme="light"]) button.p{color:#06101f}
button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{
  outline:3px solid var(--y);outline-offset:1px;
}
.row{display:flex;gap:8px;flex-wrap:wrap;align-items:end}
.row>*{flex:1 1 120px}
.row>button{flex:0 0 auto}
.note{color:var(--mut);font-size:.88rem}
.disco{margin-top:10px;padding:10px 12px;border-left:4px solid var(--y);background:var(--bg);border-radius:0 6px 6px 0;font-size:.92rem}
.hero{display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.badge{font-size:1.5rem;font-weight:800;padding:10px 18px;border-radius:8px;letter-spacing:-.01em}
.b1{background:var(--ok);color:#fff}
.b3{background:var(--r);color:#fff}
:root:not([data-theme="light"]) .b1,
:root:not([data-theme="light"]) .b3{color:#06101f}
.stats{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));margin:12px 0}
.st{border:1px solid var(--line);border-radius:8px;padding:8px 10px}
.st b{display:block;font-size:1.25rem;line-height:1.2}
.st span{color:var(--mut);font-size:.82rem}
ul{padding-left:20px;margin:6px 0}
li{margin:3px 0}
.warn{color:var(--warn)}
.bar{display:flex;align-items:center;gap:10px;margin:6px 0}
.bar em{font-style:normal;width:26px;font-weight:700}
.bar div{height:22px;border-radius:4px;min-width:4px}
.bar span{font-variant-numeric:tabular-nums}
.tw{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:.9rem}
th,td{text-align:left;padding:6px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
td input{width:70px;min-height:32px;padding:4px 6px}
td button{padding:2px 8px;min-height:30px}
details{margin-top:10px}
summary{cursor:pointer;font-weight:600}
.cfg{display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-top:10px}
